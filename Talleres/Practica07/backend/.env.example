# ────────────────────────────────────────────────────────────────────
# MultiCatálogo · backend · variables de entorno (ejemplo)
# Copiar a ".env" y rellenar valores reales. NUNCA commitear .env.
# ────────────────────────────────────────────────────────────────────

# Puerto HTTP donde escuchará el backend Fiber.
PORT=3000

# Entorno de ejecución:
#   - "production" (default): habilita HSTS y oculta details en errores.
#   - "dev": añade orígenes de Vite al CORS y muestra details en errores.
APP_ENV=production

# Secreto HS256 para firmar JWTs. Mínimo 32 bytes (recomendado: 64).
# Generar uno: `openssl rand -base64 64`
JWT_SECRET=pon-aqui-un-secreto-de-al-menos-32-bytes-please-please

# Orígenes CORS permitidos, en formato CSV (sin espacios alrededor de la coma).
# Incluir el puerto del frontend (Vite=5173, container=80, prod=tu-dominio).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Cadena de conexión PostgreSQL. Si está vacía usa el default de config/db.go.
# Formato: postgres://usuario:password@host:puerto/dbname?sslmode=disable
DATABASE_URL=postgres://admin:secret@localhost:5433/multicatalogo?sslmode=disable

# Host:puerto del servicio Redis. Default: localhost:6379.
REDIS_URL=localhost:6379
